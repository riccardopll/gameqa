{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "printWidth": 90,
    "tabWidth": 4,
    "semi": true,
    "singleQuote": false,
    "trailingComma": "all",
    "ignorePatterns": [
        "**/dist/**",
        "**/node_modules/**",
        "**/coverage/**",
        "**/playwright-report/**",
        "**/test-results/**",
    ],
}
