{
  "name": "gameqa-workspace",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "check": "oxfmt . --check && oxlint . && pnpm typecheck && pnpm test && pnpm build",
    "fix": "oxfmt . --write && oxlint . --fix",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "packageManager": "pnpm@11.7.0"
}
