{
    "name": "gameqa",
    "version": "0.1.0",
    "description": "Local CLI and SDK for SDK-instrumented game playtesting.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/riccardopll/gameqa.git"
    },
    "bin": {
        "gameqa": "dist/index.js"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "exports": {
        "./sdk": {
            "types": "./dist/sdk.d.ts",
            "import": "./dist/sdk.js"
        }
    },
    "scripts": {
        "build": "tsdown",
        "dev": "tsx src/index.ts",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@types/node": "^24.13.2",
        "tsdown": "^0.22.3",
        "tsx": "^4.22.4",
        "zod": "^4.1.13"
    },
    "engines": {
        "node": ">=24"
    }
}
