{
  "name": "gameqa",
  "version": "0.1.0",
  "description": "Local Pi-powered playtesting for SDK-instrumented web games.",
  "keywords": [
    "game-testing",
    "pi",
    "playwright",
    "qa",
    "testing"
  ],
  "homepage": "https://github.com/riccardopll/gameqa#readme",
  "bugs": {
    "url": "https://github.com/riccardopll/gameqa/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/riccardopll/gameqa.git"
  },
  "bin": {
    "gameqa": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./sdk": {
      "types": "./dist/sdk.d.ts",
      "import": "./dist/sdk.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "tsdown": "^0.22.3",
    "tsx": "^4.22.4",
    "zod": "^4.1.13"
  },
  "engines": {
    "node": ">=24"
  }
}
