{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "ignoreDeprecations": "6.0",
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "paths": {
      "gameqa/shared": ["./packages/shared/src/index.ts"],
      "gameqa/sdk": ["./packages/sdk/src/index.ts"]
    }
  }
}
